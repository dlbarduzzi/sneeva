{
  "expo": {
    "name": "sneeva",
    "slug": "sneeva",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sneeva",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.dlbarduzzi.sneeva",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "node_modules/@expo-google-fonts/geist/300Light/Geist_300Light.ttf",
              "node_modules/@expo-google-fonts/geist/300Light_Italic/Geist_300Light_Italic.ttf",
              "node_modules/@expo-google-fonts/geist/400Regular/Geist_400Regular.ttf",
              "node_modules/@expo-google-fonts/geist/400Regular_Italic/Geist_400Regular_Italic.ttf",
              "node_modules/@expo-google-fonts/geist/500Medium/Geist_500Medium.ttf",
              "node_modules/@expo-google-fonts/geist/500Medium_Italic/Geist_500Medium_Italic.ttf",
              "node_modules/@expo-google-fonts/geist/600SemiBold/Geist_600SemiBold.ttf",
              "node_modules/@expo-google-fonts/geist/600SemiBold_Italic/Geist_600SemiBold_Italic.ttf",
              "node_modules/@expo-google-fonts/geist/700Bold/Geist_700Bold.ttf",
              "node_modules/@expo-google-fonts/geist/700Bold_Italic/Geist_700Bold_Italic.ttf",
              "node_modules/@expo-google-fonts/geist/800ExtraBold/Geist_800ExtraBold.ttf",
              "node_modules/@expo-google-fonts/geist/800ExtraBold_Italic/Geist_800ExtraBold_Italic.ttf",
              "node_modules/@expo-google-fonts/geist/900Black/Geist_900Black.ttf",
              "node_modules/@expo-google-fonts/geist/900Black_Italic/Geist_900Black_Italic.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Geist",
                "fontDefinitions": [
                  {
                    "path": "node_modules/@expo-google-fonts/geist/300Light/Geist_300Light.ttf",
                    "weight": 300,
                    "style": "normal"
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/geist/300Light_Italic/Geist_300Light_Italic.ttf",
                    "weight": 300,
                    "style": "italic"
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/geist/400Regular/Geist_400Regular.ttf",
                    "weight": 400,
                    "style": "normal"
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/geist/400Regular_Italic/Geist_400Regular_Italic.ttf",
                    "weight": 400,
                    "style": "italic"
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/geist/500Medium/Geist_500Medium.ttf",
                    "weight": 500,
                    "style": "normal"
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/geist/500Medium_Italic/Geist_500Medium_Italic.ttf",
                    "weight": 500,
                    "style": "italic"
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/geist/600SemiBold/Geist_600SemiBold.ttf",
                    "weight": 600,
                    "style": "normal"
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/geist/600SemiBold_Italic/Geist_600SemiBold_Italic.ttf",
                    "weight": 600,
                    "style": "italic"
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/geist/700Bold/Geist_700Bold.ttf",
                    "weight": 700,
                    "style": "normal"
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/geist/700Bold_Italic/Geist_700Bold_Italic.ttf",
                    "weight": 700,
                    "style": "italic"
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/geist/800ExtraBold/Geist_800ExtraBold.ttf",
                    "weight": 800,
                    "style": "normal"
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/geist/800ExtraBold_Italic/Geist_800ExtraBold_Italic.ttf",
                    "weight": 800,
                    "style": "italic"
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/geist/900Black/Geist_900Black.ttf",
                    "weight": 900,
                    "style": "normal"
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/geist/900Black_Italic/Geist_900Black_Italic.ttf",
                    "weight": 900,
                    "style": "italic"
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a913dca8-8740-45f8-b9ae-3d1e9d661560"
      }
    },
    "owner": "dlbarduzzi"
  }
}
